---
import { profileData } from '../data/profile';

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
const resolveUrl = (path: string) => {
  if (!path) return '';
  if (path.startsWith('http://') || path.startsWith('https://')) return path;
  const cleanPath = path.startsWith('/') ? path.slice(1) : path;
  return `${baseUrl}${cleanPath}`;
};

const avatarSrc = resolveUrl(profileData.avatar);
const fallbackAvatar = resolveUrl('avatar.svg');
const faviconSvg = resolveUrl('favicon.svg');
const faviconIco = resolveUrl('favicon.ico');

const pageTitle = `${profileData.name.ja} (${profileData.name.en}) | Profile`;
const pageDescription = `${profileData.name.ja} (${profileData.name.en}) - ${profileData.affiliations.mainJa} ${profileData.title} のポートフォリオ・研究プロフィールサイトです。`;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <link rel="icon" href={faviconIco} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Theme Initialization Script to prevent flicker -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body>
    <!-- Background Animated Aurora Orbs -->
    <div class="background-decorations" aria-hidden="true">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
      <div class="bg-grid"></div>
    </div>

    <!-- Header Navigation -->
    <header class="header">
      <div class="header-inner">
        <a href={baseUrl} class="logo">
          <span class="logo-badge">MK</span>
          <span class="logo-name">{profileData.name.en}</span>
        </a>

        <div class="header-actions">
          <button id="theme-toggle" class="theme-toggle-btn" aria-label="テーマ切り替え" title="ライト/ダークモード切り替え">
            <!-- Sun Icon (shown in dark mode) -->
            <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
            <!-- Moon Icon (shown in light mode) -->
            <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Container -->
    <main class="main-container">
      <article class="card-glass profile-card">
        
        <!-- Hero Top Section (Avatar + Name & Status) -->
        <div class="profile-hero">
          <div class="avatar-wrapper">
            <div class="avatar-ring">
              <img
                src={avatarSrc}
                alt={profileData.name.ja}
                class="profile-avatar"
                onerror={`this.onerror=null; this.src='${fallbackAvatar}';`}
                loading="eager"
              />
            </div>
            <div class="status-indicator" title="Active">
              <span class="status-dot"></span>
              <span class="status-pulse"></span>
            </div>
          </div>

          <div class="hero-info">
            <div class="name-block">
              <div class="title-pill">
                <span class="sparkle-icon">✨</span>
                <span>{profileData.title}</span>
              </div>
              <h1 class="profile-name-ja">{profileData.name.ja}</h1>
              <p class="profile-name-en">{profileData.name.en}</p>
            </div>

            {profileData.location && (
              <div class="location-tag">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>{profileData.location}</span>
              </div>
            )}
          </div>
        </div>

        <!-- Section: Affiliations -->
        <section class="section-block affiliation-section">
          <div class="affiliation-card">
            <div class="affil-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"></path>
                <path d="M18 14h-8"></path>
                <path d="M15 18h-5"></path>
                <path d="M10 6h8v4h-8V6Z"></path>
              </svg>
            </div>
            <div class="affil-text-group">
              {profileData.affiliations.mainJa && (
                <div class="affil-ja">{profileData.affiliations.mainJa}</div>
              )}
              {profileData.affiliations.mainEn && (
                <div class="affil-en">{profileData.affiliations.mainEn}</div>
              )}
              {profileData.affiliations.lab && (
                <div class="affil-lab-row">
                  <span class="lab-label">Research Group:</span>
                  <a
                    href={profileData.affiliations.lab.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="lab-link-badge"
                  >
                    <span>{profileData.affiliations.lab.name}</span>
                    <svg class="external-arrow" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 17 17 7"></path>
                      <path d="M7 7h10v10"></path>
                    </svg>
                  </a>
                </div>
              )}
            </div>
          </div>
        </section>

        <!-- Section: Bio / About -->
        {profileData.bio && (
          <section class="section-block bio-section">
            <h2 class="section-title">
              <span class="section-title-icon">💬</span>
              <span>About</span>
            </h2>
            <div class="bio-content-box">
              <p class="profile-bio-text">{profileData.bio}</p>
            </div>
          </section>
        )}

        <!-- Section: Research Interests / Keywords -->
        {profileData.interests && profileData.interests.length > 0 && (
          <section class="section-block interests-section">
            <h2 class="section-title">
              <span class="section-title-icon">🎯</span>
              <span>Research Interests</span>
            </h2>
            <div class="interests-tags-grid">
              {profileData.interests.map((interest) => (
                <div class="interest-tag">
                  <span class="tag-hash">#</span>
                  <span>{interest}</span>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Section: Links & Profiles -->
        {profileData.links && profileData.links.length > 0 && (
          <section class="section-block links-section">
            <h2 class="section-title">
              <span class="section-title-icon">🌐</span>
              <span>Links & Profiles</span>
            </h2>
            <div class="links-grid">
              {profileData.links.map((link) => {
                const nameLower = link.name.toLowerCase();
                let iconClass = 'default';
                if (nameLower.includes('orcid')) iconClass = 'orcid';
                else if (nameLower.includes('researchmap')) iconClass = 'researchmap';
                else if (nameLower.includes('github')) iconClass = 'github';
                else if (nameLower.includes('scholar')) iconClass = 'scholar';
                else if (nameLower.includes('twitter') || nameLower.includes('x')) iconClass = 'x';

                return (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`link-card-btn link-type-${iconClass}`}
                  >
                    <div class="link-icon-container">
                      {iconClass === 'orcid' && (
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                          <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.516.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-3.994-3.722h-2.325z"/>
                        </svg>
                      )}
                      {iconClass === 'researchmap' && (
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                          <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm5.5 12h-11v-1c0-1.83 3.67-2.83 5.5-2.83s5.5 1 5.5 2.83v1z"/>
                        </svg>
                      )}
                      {iconClass === 'github' && (
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                        </svg>
                      )}
                      {iconClass === 'scholar' && (
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                          <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4 3.18v6.82h2v-5.23l6 4.73 12-9.5L12 0z"/>
                        </svg>
                      )}
                      {iconClass === 'x' && (
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                        </svg>
                      )}
                      {iconClass === 'default' && (
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"></circle>
                          <line x1="2" y1="12" x2="22" y2="12"></line>
                          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                        </svg>
                      )}
                    </div>
                    <div class="link-label-group">
                      <span class="link-name">{link.name}</span>
                    </div>
                    <div class="link-arrow">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M7 17 17 7"></path>
                        <path d="M7 7h10v10"></path>
                      </svg>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        )}

      </article>
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-inner">
        <p class="footer-copy">© {currentYear} {profileData.name.en} ({profileData.name.ja}). All Rights Reserved.</p>
        <p class="footer-sub">
          Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
          <span class="footer-sep">✦</span>
          Hosted on <a href="https://pages.github.com" target="_blank" rel="noopener noreferrer">GitHub Pages</a>
        </p>
      </div>
    </footer>

    <!-- Theme Toggle JavaScript -->
    <script>
      const themeToggleBtn = document.getElementById('theme-toggle');
      if (themeToggleBtn) {
        themeToggleBtn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }
    </script>
  </body>
</html>

<style>
  /* ==========================================================================
     CSS Custom Properties & Design Tokens
     ========================================================================== */
  :root {
    /* Color Palette - Light Mode */
    --color-bg-base: #f6f7fb;
    --color-surface-glass: rgba(255, 255, 255, 0.78);
    --color-surface-glass-subtle: rgba(255, 255, 255, 0.6);
    --color-surface-highlight: rgba(255, 255, 255, 0.95);
    
    --color-border-subtle: rgba(226, 232, 240, 0.85);
    --color-border-glass: rgba(255, 255, 255, 0.9);
    --color-border-hover: rgba(147, 51, 234, 0.35);

    --color-text-main: #0f172a;
    --color-text-body: #334155;
    --color-text-muted: #64748b;
    --color-text-subtle: #94a3b8;

    /* Accent & Brand Colors */
    --color-primary: #6366f1;
    --color-primary-deep: #4f46e5;
    --color-primary-light: #eef2ff;
    --color-accent-pink: #ec4899;
    --color-accent-purple: #8b5cf6;
    --color-accent-blue: #3b82f6;

    /* Gradients */
    --grad-primary: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
    --grad-text: linear-gradient(135deg, #4338ca 0%, #7c3aed 50%, #db2777 100%);
    --grad-subtle: linear-gradient(135deg, rgba(99, 102, 241, 0.08), rgba(236, 72, 153, 0.08));
    --grad-card-border: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(224, 231, 255, 0.6) 100%);

    /* Shadows */
    --shadow-sm: 0 2px 8px -2px rgba(15, 23, 42, 0.06), 0 1px 4px -1px rgba(15, 23, 42, 0.04);
    --shadow-md: 0 12px 32px -8px rgba(99, 102, 241, 0.12), 0 4px 16px -4px rgba(15, 23, 42, 0.06);
    --shadow-lg: 0 20px 48px -12px rgba(99, 102, 241, 0.18), 0 8px 24px -6px rgba(15, 23, 42, 0.08);
    --shadow-glow: 0 0 35px -5px rgba(168, 85, 247, 0.3);

    /* Typography & Sizing */
    --font-heading: "Plus Jakarta Sans", "Zen Kaku Gothic New", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --font-body: "Zen Kaku Gothic New", "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --font-mono: "JetBrains Mono", monospace;
    --max-width: 820px;
    --radius-lg: 24px;
    --radius-md: 16px;
    --radius-sm: 10px;
    --radius-full: 9999px;

    /* Blur Filters */
    --blur-glass: blur(16px);
  }

  /* ==========================================================================
     Dark Mode Overrides
     ========================================================================== */
  :global(html.dark) {
    --color-bg-base: #0a0d14;
    --color-surface-glass: rgba(18, 24, 38, 0.72);
    --color-surface-glass-subtle: rgba(24, 32, 50, 0.55);
    --color-surface-highlight: rgba(30, 41, 64, 0.85);

    --color-border-subtle: rgba(255, 255, 255, 0.09);
    --color-border-glass: rgba(255, 255, 255, 0.12);
    --color-border-hover: rgba(168, 85, 247, 0.5);

    --color-text-main: #f8fafc;
    --color-text-body: #cbd5e1;
    --color-text-muted: #94a3b8;
    --color-text-subtle: #64748b;

    --color-primary: #818cf8;
    --color-primary-deep: #6366f1;
    --color-primary-light: rgba(99, 102, 241, 0.15);

    --grad-text: linear-gradient(135deg, #a5b4fc 0%, #c084fc 50%, #f472b6 100%);
    --grad-subtle: linear-gradient(135deg, rgba(99, 102, 241, 0.12), rgba(236, 72, 153, 0.12));
    --grad-card-border: linear-gradient(135deg, rgba(255, 255, 255, 0.16) 0%, rgba(139, 92, 246, 0.15) 100%);

    --shadow-sm: 0 2px 8px -2px rgba(0, 0, 0, 0.4);
    --shadow-md: 0 16px 36px -8px rgba(0, 0, 0, 0.6), 0 0 25px -4px rgba(99, 102, 241, 0.15);
    --shadow-lg: 0 24px 50px -12px rgba(0, 0, 0, 0.8), 0 0 35px -6px rgba(168, 85, 247, 0.25);
    --shadow-glow: 0 0 40px -5px rgba(168, 85, 247, 0.45);
  }

  /* ==========================================================================
     Global Resets & Base Styles
     ========================================================================== */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: var(--font-body);
    background-color: var(--color-bg-base);
    color: var(--color-text-main);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  /* ==========================================================================
     Background Aurora Glow Decorations
     ========================================================================== */
  .background-decorations {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.5;
    animation: orbFloat 18s ease-in-out infinite alternate;
  }

  :global(html.dark) .orb {
    opacity: 0.38;
    filter: blur(100px);
  }

  .orb-1 {
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, #818cf8 0%, #c084fc 70%, transparent 100%);
    top: -100px;
    left: -100px;
  }

  .orb-2 {
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, #f472b6 0%, #fb7185 70%, transparent 100%);
    top: 15%;
    right: -80px;
    animation-duration: 22s;
    animation-delay: -5s;
  }

  .orb-3 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, #38bdf8 0%, #818cf8 70%, transparent 100%);
    bottom: -60px;
    left: 20%;
    animation-duration: 26s;
    animation-delay: -10s;
  }

  .bg-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(148, 163, 184, 0.15) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
  }

  @keyframes orbFloat {
    0% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(30px, 40px) scale(1.08);
    }
    100% {
      transform: translate(-20px, 20px) scale(0.95);
    }
  }

  /* ==========================================================================
     Header
     ========================================================================== */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: var(--blur-glass);
    -webkit-backdrop-filter: var(--blur-glass);
    background: var(--color-surface-glass);
    border-bottom: 1px solid var(--color-border-subtle);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.85rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .logo-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--grad-primary);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: -0.5px;
    box-shadow: 0 2px 8px rgba(99, 102, 241, 0.35);
  }

  .logo-name {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.3px;
    color: var(--color-text-main);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

