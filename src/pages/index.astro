---
import { profileData } from '../data/profile';

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
const resolveUrl = (path: string) => {
  if (!path) return '';
  if (path.startsWith('http://') || path.startsWith('https://')) return path;
  const cleanPath = path.startsWith('/') ? path.slice(1) : path;
  return `${baseUrl}${cleanPath}`;
};

const avatarSrc = resolveUrl(profileData.avatar);
const fallbackAvatar = resolveUrl('avatar.svg');
const faviconSvg = resolveUrl('favicon.svg');
const faviconIco = resolveUrl('favicon.ico');

const pageTitle = `${profileData.name.ja} (${profileData.name.en}) | Profile`;
const pageDescription = `${profileData.name.ja} (${profileData.name.en}) - ${profileData.affiliations.mainJa} ${profileData.title} の研究プロフィールサイトです。`;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <link rel="icon" href={faviconIco} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Theme Initialization Script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body>
    <!-- Header Navigation -->
    <header class="header">
      <div class="header-inner">
        <a href={baseUrl} class="logo">
          <span class="logo-badge">MK</span>
          <span class="logo-name">{profileData.name.en}</span>
        </a>

        <div class="header-actions">
          <button id="theme-toggle" class="theme-toggle-btn" aria-label="テーマ切り替え" title="ライト/ダークモード切り替え">
            <!-- Sun Icon (shown in dark mode) -->
            <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
            <!-- Moon Icon (shown in light mode) -->
            <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Container -->
    <main class="main-container">
      <article class="profile-card">
        
        <!-- Hero Section (Avatar + Name + Status) -->
        <div class="profile-hero">
          <div class="avatar-wrapper">
            <div class="avatar-ring">
              <img
                src={avatarSrc}
                alt={profileData.name.ja}
                class="profile-avatar"
                onerror={`this.onerror=null; this.src='${fallbackAvatar}';`}
                loading="eager"
              />
            </div>
          </div>

          <div class="hero-info">
            <div class="name-block">
              <div class="title-pill">
                <span class="status-dot"></span>
                <span>{profileData.title}</span>
              </div>
              <h1 class="profile-name-ja">{profileData.name.ja}</h1>
              <p class="profile-name-en">{profileData.name.en}</p>
            </div>

            {profileData.location && (
              <div class="location-tag">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>{profileData.location}</span>
              </div>
            )}
          </div>
        </div>

        <!-- Section: Affiliations -->
        <section class="section-block affiliation-section">
          <div class="affiliation-card">
            <div class="affil-text-group">
              {profileData.affiliations.mainJa && (
                <div class="affil-ja">{profileData.affiliations.mainJa}</div>
              )}
              {profileData.affiliations.mainEn && (
                <div class="affil-en">{profileData.affiliations.mainEn}</div>
              )}
              {profileData.affiliations.lab && (
                <div class="affil-lab-row">
                  <span class="lab-label">Research Lab:</span>
                  <a
                    href={profileData.affiliations.lab.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="lab-link-badge"
                  >
                    <span>{profileData.affiliations.lab.name}</span>
                    <svg class="external-arrow" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 17 17 7"></path>
                      <path d="M7 7h10v10"></path>
                    </svg>
                  </a>
                </div>
              )}
            </div>
          </div>
        </section>

        <!-- Section: Bio / About -->
        {profileData.bio && (
          <section class="section-block bio-section">
            <h2 class="section-title">About</h2>
            <div class="bio-content-box">
              <p class="profile-bio-text">{profileData.bio}</p>
            </div>
          </section>
        )}

        <!-- Section: Research Interests -->
        {profileData.interests && profileData.interests.length > 0 && (
          <section class="section-block interests-section">
            <h2 class="section-title">Research Interests</h2>
            <div class="interests-tags-grid">
              {profileData.interests.map((interest) => (
                <div class="interest-tag">
                  <span class="tag-bullet">•</span>
                  <span>{interest}</span>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Section: Links & Profiles -->
        {profileData.links && profileData.links.length > 0 && (
          <section class="section-block links-section">
            <h2 class="section-title">Links & Profiles</h2>
            <div class="links-grid">
              {profileData.links.map((link) => {
                const nameLower = link.name.toLowerCase();
                let iconType = 'default';
                if (nameLower.includes('orcid')) iconType = 'orcid';
                else if (nameLower.includes('researchmap')) iconType = 'researchmap';
                else if (nameLower.includes('github')) iconType = 'github';
                else if (nameLower.includes('scholar')) iconType = 'scholar';
                else if (nameLower.includes('twitter') || nameLower.includes('x')) iconType = 'x';

                return (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`link-card-btn link-type-${iconType}`}
                  >
                    <div class="link-icon-container">
                      {iconType === 'orcid' && (
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                          <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.516.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-3.994-3.722h-2.325z"/>
                        </svg>
                      )}
                      {iconType === 'researchmap' && (
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                          <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm5.5 12h-11v-1c0-1.83 3.67-2.83 5.5-2.83s5.5 1 5.5 2.83v1z"/>
                        </svg>
                      )}
                      {iconType === 'github' && (
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                        </svg>
                      )}
                      {iconType === 'scholar' && (
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                          <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4 3.18v6.82h2v-5.23l6 4.73 12-9.5L12 0z"/>
                        </svg>
                      )}
                      {iconType === 'x' && (
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                        </svg>
                      )}
                      {iconType === 'default' && (
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"></circle>
                          <line x1="2" y1="12" x2="22" y2="12"></line>
                          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                        </svg>
                      )}
                    </div>
                    <span class="link-name">{link.name}</span>
                    <svg class="link-arrow" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 17 17 7"></path>
                      <path d="M7 7h10v10"></path>
                    </svg>
                  </a>
                );
              })}
            </div>
          </section>
        )}

      </article>
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-inner">
        <p class="footer-copy">© {currentYear} {profileData.name.en} ({profileData.name.ja}). All Rights Reserved.</p>
        <p class="footer-sub">
          Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
          <span class="footer-sep">·</span>
          Hosted on <a href="https://pages.github.com" target="_blank" rel="noopener noreferrer">GitHub Pages</a>
        </p>
      </div>
    </footer>

    <!-- Theme Toggle JavaScript -->
    <script>
      const themeToggleBtn = document.getElementById('theme-toggle');
      if (themeToggleBtn) {
        themeToggleBtn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }
    </script>
  </body>
</html>

<style>
  /* ==========================================================================
     Lemon Yellow Academic Design Tokens (Clean & Lightweight)
     ========================================================================== */
  :root {
    /* Lemon Palette - Light Mode */
    --color-bg-base: #fbfbf6;
    --color-card-bg: #ffffff;
    --color-surface-subtle: #fefce8;
    --color-surface-hover: #fef9c3;
    
    --color-lemon-primary: #ca8a04;
    --color-lemon-badge-bg: #fef9c3;
    --color-lemon-badge-border: #fef08a;
    --color-lemon-badge-text: #854d0e;
    --color-lemon-accent: #fde047;
    --color-lemon-dot: #eab308;

    --color-border: #e8eaed;
    --color-border-subtle: #f1f3f5;
    --color-border-lemon: #fde047;

    --color-text-main: #0f172a;
    --color-text-body: #334155;
    --color-text-muted: #64748b;
    --color-text-subtle: #94a3b8;

    /* Shadows & Radii */
    --shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
    --shadow-card: 0 4px 16px -2px rgba(15, 23, 42, 0.05), 0 1px 3px 0 rgba(15, 23, 42, 0.02);

    --font-heading: "Plus Jakarta Sans", "Zen Kaku Gothic New", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --font-body: "Zen Kaku Gothic New", "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --max-width: 780px;
    --radius-card: 16px;
    --radius-sm: 8px;
    --radius-pill: 9999px;
  }

  /* Dark Mode */
  :global(html.dark) {
    --color-bg-base: #0c1017;
    --color-card-bg: #151d2a;
    --color-surface-subtle: #1c2637;
    --color-surface-hover: #243046;

    --color-lemon-primary: #fde047;
    --color-lemon-badge-bg: rgba(254, 240, 138, 0.12);
    --color-lemon-badge-border: rgba(254, 240, 138, 0.25);
    --color-lemon-badge-text: #fef08a;
    --color-lemon-accent: #facc15;
    --color-lemon-dot: #facc15;

    --color-border: #263347;
    --color-border-subtle: #1e293b;
    --color-border-lemon: #854d0e;

    --color-text-main: #f8fafc;
    --color-text-body: #cbd5e1;
    --color-text-muted: #94a3b8;
    --color-text-subtle: #64748b;

    --shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.4);
    --shadow-card: 0 4px 20px -2px rgba(0, 0, 0, 0.5);
  }

  /* Reset */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: var(--font-body);
    background-color: var(--color-bg-base);
    color: var(--color-text-main);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* Header */
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-card-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.85rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .logo-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: var(--color-lemon-badge-bg);
    border: 1px solid var(--color-lemon-badge-border);
    color: var(--color-lemon-badge-text);
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .logo-name {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .header-actions {
    display: flex;
    align-items: center;
  }

  .theme-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    color: var(--color-text-body);
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .theme-toggle-btn:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-lemon-accent);
  }

  .sun-icon { display: none; color: #facc15; }
  .moon-icon { display: block; color: var(--color-lemon-primary); }
  :global(html.dark) .sun-icon { display: block; }
  :global(html.dark) .moon-icon { display: none; }

  /* Main Container */
  .main-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2.5rem 1.25rem 3.5rem;
    flex: 1;
    width: 100%;
  }

  .profile-card {
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-lemon-accent);
    border-radius: var(--radius-card);
    padding: 2.75rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    box-shadow: var(--shadow-card);
  }

  /* Hero Section */
  .profile-hero {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .avatar-wrapper {
    flex-shrink: 0;
  }

  .avatar-ring {
    padding: 3px;
    background: var(--color-lemon-badge-bg);
    border: 1px solid var(--color-lemon-badge-border);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .profile-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    background: var(--color-surface-subtle);
  }

  .hero-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .name-block {
    display: flex;
    flex-direction: column;
  }

  .title-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.75rem;
    background: var(--color-lemon-badge-bg);
    border: 1px solid var(--color-lemon-badge-border);
    border-radius: var(--radius-pill);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-lemon-badge-text);
    margin-bottom: 0.45rem;
    width: fit-content;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    background: var(--color-lemon-dot);
    border-radius: 50%;
  }

  .profile-name-ja {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-text-main);
  }

  .profile-name-en {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin-top: 0.15rem;
  }

  .location-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.84rem;
    color: var(--color-text-subtle);
    font-weight: 500;
  }

  /* Section Common */
  .section-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-main);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: 0.35rem;
  }

  /* Affiliation */
  .affiliation-card {
    padding: 1.25rem 1.4rem;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-lemon-accent);
    border-radius: var(--radius-sm);
  }

  .affil-text-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .affil-ja {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .affil-en {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .affil-lab-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.4rem;
    font-size: 0.88rem;
  }

  .lab-label {
    font-weight: 600;
    color: var(--color-text-muted);
    font-size: 0.84rem;
  }

  .lab-link-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.65rem;
    background: var(--color-card-bg);
    border: 1px solid var(--color-lemon-badge-border);
    border-radius: var(--radius-pill);
    color: var(--color-lemon-badge-text);
    font-weight: 600;
    font-size: 0.84rem;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .lab-link-badge:hover {
    background: var(--color-lemon-badge-bg);
